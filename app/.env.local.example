# Copy to app/.env; replace every change-me value before starting the stack.
# Used by docker-compose.local.yml, not by the older deployment stacks.
AUTH_SECRET_KEY=change-me-to-a-random-secret-at-least-32-characters
POSTGRES_PASSWORD=change-me-postgres-password
MINIO_ACCESS_KEY=scenesearch-local
MINIO_SECRET_KEY=change-me-minio-password
QWEN_EMBEDDING_API_KEY=change-me-internal-embedding-token
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=change-me-local-admin-password
ML_QWEN_MODEL_NAME=Qwen/Qwen3-VL-Embedding-2B
ML_MODEL_VERSION=qwen3-vl-embedding-2b-v1
# Optional. Chat and VLM metadata need an OpenAI-compatible external/local LLM.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
