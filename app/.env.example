# ==============================================================================
# SceneSearch Environment Configuration Template (.env.example)
# ==============================================================================

# --- Application Core ---
APP_NAME=SceneSearch-P-081
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# --- Authentication & Security ---
AUTH_SECRET_KEY=generate-a-strong-secret-key-32-chars-minimum
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Relational Database (PostgreSQL) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=scenesearch
POSTGRES_PASSWORD=scenesearch
POSTGRES_DB=scenesearch
DATABASE_URL=postgresql+asyncpg://scenesearch:scenesearch@localhost:5432/scenesearch

# --- Cache & Task Queue (Redis & Celery) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_TASK_TIME_LIMIT=3600
CELERY_RESULT_EXPIRES=86400

# --- Object Storage (MinIO / S3) ---
# Local Docker MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=scenesearch
MINIO_RAW_BUCKET=scenesearch-raw
MINIO_DERIVED_BUCKET=scenesearch-derived
MINIO_URL_TTL_SECONDS=3600
MINIO_SECURE=false

# Remote Viettech Media Proxy (Optional: set to connect to shared public store)
# MINIO_SCENE_MEDIA_ENDPOINT=bucket.viettech.fit
# MINIO_SCENE_MEDIA_BUCKET=scenesearch-derived
# MINIO_SCENE_MEDIA_SECURE=true
# MINIO_SCENE_MEDIA_CONSOLE=false

# --- Vector Database (Qdrant) ---
# Option 1: Remote Viettech Qdrant (Shared Cloud Index)
QDRANT_URL=https://qdrant.viettech.fit:443
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=Scences
QDRANT_TIMEOUT=60
QDRANT_VECTOR_SIZE=2048

# Option 2: Local Docker Qdrant (Uncomment for standalone local instance)
# QDRANT_HOST=localhost
# QDRANT_PORT=6333
# QDRANT_GRPC_PORT=6334
# QDRANT_COLLECTION=scenes
# QDRANT_VECTOR_SIZE=2048
# QDRANT_HNSW_EF_SEARCH=128

# --- Search Engine & Retrieval Settings ---
# Modes: "qwen" (Primary Qwen Vector Search), "hybrid" (SigLIP + Lexical), or "siglip"
SEARCH_MODE=qwen
SEARCH_VISUAL_VECTOR=qwen
SEARCH_CAPTION_VECTOR=
SEARCH_KEYFRAME_FPS=5
SEARCH_VISUAL_FLOOR=0.15
SEARCH_CAPTION_FLOOR=0.15
SEARCH_STRICT_CONCEPTS=false

# --- Tri-Tier Agentic Search & LLM Configuration ---
# Master toggle for Agentic Search (Single-Pass Gateway + HyDE + Evaluator)
SEARCH_AGENTIC_ENABLED=true
SEARCH_HYDE_ENABLED=true
SEARCH_DOMAIN_GUARDRAIL_ENABLED=true
SEARCH_MAX_REFLECTION_LOOPS=2

# LLM Gateway Settings (NVIDIA NIM / OpenAI Compatible API)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=nvapi-your_nvidia_api_key_here
LLM_MODEL=meta/llama-3.1-8b-instruct
LLM_TIMEOUT_SECONDS=10.0
LLM_MAX_RETRIES=2

# --- Machine Learning & Encoders ---
# Device resolution: "auto" (prefers MPS on Mac, CUDA on Linux/Nvidia, or CPU)
ML_DEVICE=auto
ML_ENCODER_NAME=Qwen/Qwen3-VL-Embedding-2B
ML_QWEN_MODEL_NAME=Qwen/Qwen3-VL-Embedding-2B
ML_MODEL_VERSION=qwen3-vl-embedding-2b-v1
ML_DTYPE=float16
ML_BATCH_SIZE=1
ML_IMAGE_SIZE=224
ML_NUM_WORKERS=2

# Shared Qwen embedding service used by API and ingestion worker.
ML_QWEN_MODEL_NAME=Qwen/Qwen3-VL-Embedding-2B
QWEN_EMBEDDING_URL=http://qwen-embedding:8001
QWEN_EMBEDDING_API_KEY=replace-with-a-long-random-secret
QWEN_EMBEDDING_TIMEOUT=300
QWEN_EMBEDDING_BATCH_SIZE=1
QWEN_EMBEDDING_REQUEST_BATCH_SIZE=8

# Cross-Encoder Reranker (Optional)
SEARCH_RERANK_ENABLED=false
SEARCH_RERANK_TOP_K=30
ML_RERANKER_NAME=Qwen/Qwen3-VL-Reranker-2B
ML_RERANKER_DEVICE=cuda

# --- Video Processing & Sampling ---
VIDEO_SAMPLE_FPS=5.0
VIDEO_DEDUP_ENABLED=true
VIDEO_DEDUP_THRESHOLD=0.98
VIDEO_SEGMENT_SECONDS=5.0
VIDEO_SEGMENT_GAP_TOLERANCE_S=1.0
VIDEO_PREVIEW_CODEC=libx264
VIDEO_PREVIEW_CRF=28
VIDEO_PREVIEW_MAX_EDGE=1280
VIDEO_PREVIEW_FPS=5.0
VIDEO_MAX_DURATION_S=600
VIDEO_MAX_PIXELS=8847360

# --- Dataset Layout ---
DATASET_NAME=driving-video-object-tracking
DATASET_SPLIT=val
DATASET_ROOT=data/driving-video-object-tracking
DATASET_MANIFEST_NAME=manifest.jsonl
DATASET_THUMBNAIL_MAX_EDGE=512
DATASET_THUMBNAIL_QUALITY=80

# --- AI Activity Logging ---
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log
