# Single template for app/.env: local Linux/NVIDIA and GCP GPU VM.
# Replace change-me values. Never commit app/.env.
# Run Compose from repo root with --env-file app/.env (the Makefile does this).
# Docker overrides service URLs below for its internal network; all other app
# options come from this file. Native Python reads app/.env regardless of cwd.

# Deployment / browser entry point (Compose only).
COMPOSE_PROJECT_NAME=scenesearch-local
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PORT=5173

# Application.
APP_ENV=production
APP_DEBUG=false
APP_NAME=SceneSearch-P-081
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Authentication and explicit administrator bootstrap (make local-admin).
AUTH_SECRET_KEY=change-me-to-a-random-secret-at-least-32-characters
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
LOCAL_ADMIN_EMAIL=admin@example.com
LOCAL_ADMIN_PASSWORD=change-me-local-admin-password

# PostgreSQL: Docker fixes user/database to scenesearch to match existing volumes.
POSTGRES_PASSWORD=change-me-postgres-password
# DATABASE_URL is an optional native-host override; Compose constructs its own.
# DATABASE_URL=postgresql+asyncpg://scenesearch:YOUR_PASSWORD@127.0.0.1:5432/scenesearch

# Native-host Redis URLs; Compose uses redis:6379 and these same DB numbers.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_TASK_TIME_LIMIT=3600
CELERY_RESULT_EXPIRES=86400

# MinIO. Endpoint/TLS are routed internally in Docker; credentials/buckets are shared.
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=false
MINIO_ACCESS_KEY=scenesearch-local
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=scenesearch
MINIO_RAW_BUCKET=scenesearch-raw
MINIO_DERIVED_BUCKET=scenesearch-derived
MINIO_URL_TTL_SECONDS=3600

# Qdrant: preserve collection/vector contract for the existing corpus.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=scenes_local
QDRANT_TIMEOUT=10
QDRANT_VECTOR_SIZE=2048
QDRANT_WRITE_VECTOR_NAME=qwen
QDRANT_ALLOW_NAMED_VECTOR_WRITES=true

# Search and optional agent/reranking behavior.
SEARCH_MODE=qwen
SEARCH_VISUAL_VECTOR=qwen
SEARCH_CAPTION_VECTOR=
SEARCH_KEYFRAME_FPS=5
SEARCH_VISUAL_FLOOR=0.09
SEARCH_QWEN_VISUAL_FLOOR=0.02
SEARCH_CAPTION_FLOOR=0.0
SEARCH_STRICT_CONCEPTS=false
SEARCH_AGENTIC_ENABLED=true
SEARCH_HYDE_ENABLED=true
SEARCH_DOMAIN_GUARDRAIL_ENABLED=true
SEARCH_MAX_REFLECTION_LOOPS=1
SEARCH_RERANK_ENABLED=true
SEARCH_RERANK_TOP_K=30
ML_RERANKER_NAME=Qwen/Qwen3-VL-Reranker-2B
ML_RERANKER_DEVICE=auto

# Optional OpenAI-compatible LLM for chat and agent/VLM metadata.
LLM_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b
LLM_TIMEOUT=10
LLM_TEMPERATURE=0.2

# Shared embedding model contract.
ML_ENCODER_NAME=Qwen/Qwen3-VL-Embedding-2B
ML_QWEN_MODEL_NAME=Qwen/Qwen3-VL-Embedding-2B
ML_MODEL_VERSION=qwen3-vl-embedding-2b-v1
ML_DEVICE=cuda
ML_DTYPE=float16
# API/worker encoder request batch; GPU server uses QWEN_EMBEDDING_BATCH_SIZE.
ML_BATCH_SIZE=64
ML_IMAGE_SIZE=224
ML_NUM_WORKERS=2
QWEN_EMBEDDING_URL=http://localhost:8001
QWEN_EMBEDDING_API_KEY=change-me-internal-embedding-token
QWEN_EMBEDDING_TIMEOUT=300
QWEN_EMBEDDING_BATCH_SIZE=1

# Optional privacy checkpoint download. Keep existing deployment values if set.
# ML_PRIVACY_YOLO_WEIGHTS=/models/privacy.pt
# ML_PRIVACY_YOLO_WEIGHTS_URL=https://YOUR_HOST/privacy.pt
# ML_PRIVACY_YOLO_WEIGHTS_SHA256=YOUR_64_CHARACTER_SHA256
ML_PRIVACY_YOLO_CONFIDENCE=0.25
ML_PRIVACY_YOLO_IMAGE_SIZE=960

# Video ingestion. These defaults preserve the current runtime sampling behavior.
VIDEO_SAMPLE_FPS=1
VIDEO_SAMPLING_MAX_GAP_SEC=2
VIDEO_SAMPLING_SSIM_THRESHOLD=0.98
VIDEO_DEDUP_ENABLED=true
VIDEO_DEDUP_THRESHOLD=0.98
VIDEO_SEGMENT_SECONDS=5
VIDEO_SEGMENT_GAP_TOLERANCE_S=1
VIDEO_PREVIEW_CODEC=libx264
VIDEO_PREVIEW_CRF=28
VIDEO_PREVIEW_MAX_EDGE=1280
VIDEO_PREVIEW_FPS=5
VIDEO_MAX_DURATION_S=600
VIDEO_MAX_PIXELS=8847360

# Dataset converter layout (relative paths keep their documented command semantics).
DATASET_NAME=driving-video-object-tracking
DATASET_SPLIT=val
DATASET_ROOT=data/driving-video-object-tracking
DATASET_MANIFEST_NAME=manifest.jsonl
DATASET_THUMBNAIL_MAX_EDGE=512
DATASET_THUMBNAIL_QUALITY=80
