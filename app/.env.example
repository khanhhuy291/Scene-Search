# ==============================================================================
# SceneSearch Production Environment Configuration (app/.env)
# ==============================================================================

# --- Application Core ---
APP_NAME=SceneSearch-P-081
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
# Cho phép các nguồn gốc truy cập giao diện qua CORS
APP_CORS_ORIGINS=["*"]

# Cổng truy cập Web UI khi deploy
DEPLOY_PORT=8088
DEPLOY_PUBLIC_ORIGIN=http://localhost:8088

# --- Authentication & Security (JWT) ---
# Dùng để ký và giải mã JWT token cho Admin và Engineer.
# Các API Video Ingestion (/api/v1/ingest/*) yêu cầu JWT token của tài khoản Admin.
AUTH_SECRET_KEY=f8a9e40b3c1d765892acb84e3170df5249a8c14f08de6299b418ce920401b7a2
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Relational Database (PostgreSQL Cloud SQL / Docker) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=scenesearch
POSTGRES_PASSWORD=scenesearch
POSTGRES_DB=scenesearch
DATABASE_URL=postgresql+asyncpg://scenesearch:scenesearch@postgres:5432/scenesearch

# --- Cache & Task Queue (Redis & Celery Worker) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_TASK_TIME_LIMIT=3600
CELERY_RESULT_EXPIRES=86400

# --- Object Storage (MinIO / GCP Cloud Storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=scenesearch
MINIO_RAW_BUCKET=scenesearch-raw
MINIO_DERIVED_BUCKET=scenesearch-derived
MINIO_URL_TTL_SECONDS=3600
MINIO_SECURE=false

# --- Vector Database (Qdrant) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=Scences
# Ingestion and search collections.
QDRANT_CHUNK_COLLECTION=scene_chunks
QDRANT_KEYFRAME_COLLECTION=scene_keyframes
QDRANT_TIMEOUT=60
QDRANT_VECTOR_SIZE=2048
QDRANT_WRITE_VECTOR_NAME=qwen
QDRANT_ALLOW_NAMED_VECTOR_WRITES=true

# --- Search Engine & Retrieval Settings ---
# Hybrid combines chunk SigLIP/Qwen, caption and keyframe retrieval.
SEARCH_MODE=hybrid
SEARCH_VISUAL_FLOOR=0.09
SEARCH_QWEN_VISUAL_FLOOR=0.02
SEARCH_CAPTION_FLOOR=0.0
SEARCH_STRICT_CONCEPTS=false

# --- Tri-Tier Agentic Search & LLM (NVIDIA NIM) ---
SEARCH_AGENTIC_ENABLED=true
SEARCH_HYDE_ENABLED=true
SEARCH_DOMAIN_GUARDRAIL_ENABLED=true
SEARCH_MAX_REFLECTION_LOOPS=2

LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your_nvidia_api_key_here
LLM_MODEL=moonshotai/kimi-k3
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# --- Machine Learning & Embedding Microservice ---
# Cấu hình thiết bị: "cuda" (cho GPU/Cloud Run/Linux), "mps" (Mac), hoặc "auto"
ML_DEVICE=cuda
# Local YOLO checkpoint with face and license_plate classes.
# ML_PRIVACY_YOLO_WEIGHTS=/models/privacy.pt
# Uncomment URL and SHA-256 to download the evaluation checkpoint.
# ML_PRIVACY_YOLO_WEIGHTS_URL=https://github.com/H-Held/yolo26-license-plate-face-detection/releases/download/v3.0.0/yolo26m_face_lp.pt
# ML_PRIVACY_YOLO_WEIGHTS_SHA256=56f5ba2f43a9f86db8907226c5ccccee4182b00d83e38234b9317255eb26a7e2
# ML_PRIVACY_YOLO_CACHE_DIR=/home/appuser/.cache/scenesearch/privacy
# ML_PRIVACY_YOLO_CONFIDENCE=0.25
# ML_PRIVACY_YOLO_IMAGE_SIZE=960
ML_DTYPE=float16
ML_BATCH_SIZE=1
ML_IMAGE_SIZE=224
ML_NUM_WORKERS=2
ML_ENCODER_NAME=Qwen/Qwen3-VL-Embedding-2B
ML_QWEN_MODEL_NAME=Qwen/Qwen3-VL-Embedding-2B
ML_MODEL_VERSION=qwen3-vl-embedding-2b-v1

# Shared Qwen & SigLIP embedding microservice (Port 8001)
# Khi chạy qua Docker Compose: http://embedding-api:8001
# Khi chạy local host: http://localhost:8001
# Token xác thực nội bộ: Cả Qwen và SigLIP remote pipeline đều dùng key này để gọi API
QWEN_EMBEDDING_URL=http://embedding-api:8001
QWEN_EMBEDDING_API_KEY=scenesearch-internal
QWEN_EMBEDDING_TIMEOUT=120.0
QWEN_EMBEDDING_BATCH_SIZE=1
QWEN_EMBEDDING_REQUEST_BATCH_SIZE=8

# --- Cross-Encoder Reranker (Qwen3-VL-Reranker-2B) ---
SEARCH_RERANK_ENABLED=false
SEARCH_RERANK_TOP_K=30
ML_RERANKER_NAME=Qwen/Qwen3-VL-Reranker-2B
ML_RERANKER_DEVICE=cuda

# --- Video Processing & Ingestion Sampling ---
VIDEO_SAMPLE_FPS=5.0
VIDEO_SEGMENT_GAP_TOLERANCE_S=1.0
# Semantic scenes followed by retrieval chunks.
# Initial thresholds and 8s/6s windows are experimental, NOT calibrated.
VIDEO_SEMANTIC_CONTEXT_WINDOW_S=2.0
# Baseline permits partial windows and records coverage; calibrate before raising.
VIDEO_SEMANTIC_MIN_WINDOW_COVERAGE=0.0
VIDEO_SEMANTIC_SMOOTHING_WINDOW_S=1.0
VIDEO_SEMANTIC_ADAPTIVE_THRESHOLD=true
VIDEO_SEMANTIC_THRESHOLD_FLOOR=0.05
VIDEO_SEMANTIC_MAD_MULTIPLIER=3.0
VIDEO_SEMANTIC_MIN_SCENE_DURATION_S=3.0
VIDEO_SEMANTIC_MERGE_SIMILAR_SCENES=true
VIDEO_SEMANTIC_MERGE_DISTANCE=0.10
VIDEO_SEMANTIC_STRONG_BOUNDARY_DISTANCE=0.15
VIDEO_RETRIEVAL_CHUNK_DURATION_S=8.0
VIDEO_RETRIEVAL_CHUNK_STRIDE_S=6.0
VIDEO_KEYFRAME_MIN_FRAMES=3
VIDEO_KEYFRAME_MAX_FRAMES=6
VIDEO_KEYFRAME_NOVELTY_DISTANCE=0.02
VIDEO_KEYFRAME_QUALITY_WEIGHT=0.05
VIDEO_VLM_MIN_FRAMES=3
VIDEO_VLM_MAX_FRAMES=3
VIDEO_VLM_NOVELTY_DISTANCE=0.02
VIDEO_VLM_CONCURRENCY=2
VIDEO_VLM_TIMEOUT_S=30
VIDEO_VLM_MAX_TOKENS=4096
VIDEO_VLM_ATTEMPTS_PER_REQUEST=2

# --- Dataset Layout ---
DATASET_NAME=driving-video-object-tracking
DATASET_SPLIT=val
DATASET_ROOT=data/driving-video-object-tracking
DATASET_MANIFEST_NAME=manifest.jsonl
DATASET_THUMBNAIL_MAX_EDGE=512
DATASET_THUMBNAIL_QUALITY=80
