# ==============================================================================
# SceneSearch Production Environment Configuration (app/.env)
# ==============================================================================

# --- Application Core ---
APP_NAME=SceneSearch-P-081
APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
# Cho phép các nguồn gốc truy cập giao diện qua CORS
APP_CORS_ORIGINS=["*"]

# Cổng truy cập Web UI khi deploy
DEPLOY_PORT=8088
DEPLOY_PUBLIC_ORIGIN=http://localhost:8088

# --- Authentication & Security (JWT) ---
# Dùng để ký và giải mã JWT token cho Admin và Engineer.
# Các API Video Ingestion (/api/v1/ingest/*) yêu cầu JWT token của tài khoản Admin.
AUTH_SECRET_KEY=f8a9e40b3c1d765892acb84e3170df5249a8c14f08de6299b418ce920401b7a2
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Relational Database (PostgreSQL Cloud SQL / Docker) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=scenesearch
POSTGRES_PASSWORD=scenesearch
POSTGRES_DB=scenesearch
DATABASE_URL=postgresql+asyncpg://scenesearch:scenesearch@postgres:5432/scenesearch

# --- Cache & Task Queue (Redis & Celery Worker) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_SOFT_TIME_LIMIT=3300
CELERY_TASK_TIME_LIMIT=3600
CELERY_RESULT_EXPIRES=86400

# --- Object Storage (MinIO / GCP Cloud Storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=scenesearch
MINIO_RAW_BUCKET=scenesearch-raw
MINIO_DERIVED_BUCKET=scenesearch-derived
MINIO_URL_TTL_SECONDS=3600
MINIO_SECURE=false

# --- Vector Database (Qdrant) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=Scences
QDRANT_TIMEOUT=60
QDRANT_VECTOR_SIZE=2048
QDRANT_WRITE_VECTOR_NAME=qwen
QDRANT_ALLOW_NAMED_VECTOR_WRITES=true

# --- Search Engine & Retrieval Settings ---
# Retrieval Mode: "qwen" (Primary 2048d), "hybrid" (SigLIP 768d + Qwen 2048d), hoặc "siglip"
SEARCH_MODE=qwen
SEARCH_VISUAL_VECTOR=qwen
SEARCH_CAPTION_VECTOR=
SEARCH_KEYFRAME_FPS=5
SEARCH_VISUAL_FLOOR=0.09
SEARCH_QWEN_VISUAL_FLOOR=0.02
SEARCH_CAPTION_FLOOR=0.0
SEARCH_STRICT_CONCEPTS=false

# --- Tri-Tier Agentic Search & LLM (NVIDIA NIM) ---
SEARCH_AGENTIC_ENABLED=true
SEARCH_HYDE_ENABLED=true
SEARCH_DOMAIN_GUARDRAIL_ENABLED=true
SEARCH_MAX_REFLECTION_LOOPS=2

LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=your_nvidia_api_key_here
LLM_MODEL=moonshotai/kimi-k3
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_RETRIES=2

# --- Machine Learning & Embedding Microservice ---
# Cấu hình thiết bị: "cuda" (cho GPU/Cloud Run/Linux), "mps" (Mac), hoặc "auto"
ML_DEVICE=cuda
ML_DTYPE=float16
ML_BATCH_SIZE=1
ML_IMAGE_SIZE=224
ML_NUM_WORKERS=2
ML_ENCODER_NAME=Qwen/Qwen3-VL-Embedding-2B
ML_QWEN_MODEL_NAME=Qwen/Qwen3-VL-Embedding-2B
ML_MODEL_VERSION=qwen3-vl-embedding-2b-v1

# Shared Qwen & SigLIP embedding microservice (Port 8001)
# Khi chạy qua Docker Compose: http://embedding-api:8001
# Khi chạy local host: http://localhost:8001
# Token xác thực nội bộ: Cả Qwen và SigLIP remote pipeline đều dùng key này để gọi API
QWEN_EMBEDDING_URL=http://embedding-api:8001
QWEN_EMBEDDING_API_KEY=scenesearch-internal
QWEN_EMBEDDING_TIMEOUT=120.0
QWEN_EMBEDDING_BATCH_SIZE=1
QWEN_EMBEDDING_REQUEST_BATCH_SIZE=8

# --- Cross-Encoder Reranker (Qwen3-VL-Reranker-2B) ---
SEARCH_RERANK_ENABLED=false
SEARCH_RERANK_TOP_K=30
ML_RERANKER_NAME=Qwen/Qwen3-VL-Reranker-2B
ML_RERANKER_DEVICE=cuda

# --- Video Processing & Ingestion Sampling ---
VIDEO_SAMPLE_FPS=5.0
VIDEO_DEDUP_ENABLED=true
VIDEO_DEDUP_THRESHOLD=0.98
VIDEO_SEGMENT_SECONDS=5.0
VIDEO_SEGMENT_GAP_TOLERANCE_S=1.0
VIDEO_PREVIEW_CODEC=libx264
VIDEO_PREVIEW_CRF=28
VIDEO_PREVIEW_MAX_EDGE=1280
VIDEO_PREVIEW_FPS=5.0
VIDEO_MAX_DURATION_S=600
VIDEO_MAX_PIXELS=8847360

# --- Dataset Layout ---
DATASET_NAME=driving-video-object-tracking
DATASET_SPLIT=val
DATASET_ROOT=data/driving-video-object-tracking
DATASET_MANIFEST_NAME=manifest.jsonl
DATASET_THUMBNAIL_MAX_EDGE=512
DATASET_THUMBNAIL_QUALITY=80

# --- AI Activity Logging ---
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log
